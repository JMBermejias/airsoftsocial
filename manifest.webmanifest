{
  "id": "./",
  "name": "Airsoft Social",
  "short_name": "Airsoft Social",
  "description": "Red social para la comunidad airsoft: noticias, historias con vídeo, amigos, rangos, campos de juego y tienda online de afiliación.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#20251a",
  "theme_color": "#3f4a2f",
  "categories": ["social", "social_networking", "sports"],
  "icons": [
    {
      "src": "./icon.php/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.php/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon.php/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icon.php/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./favicon.ico",
      "sizes": "16x16 32x32 48x48",
      "type": "image/x-icon",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Noticias",
      "short_name": "Noticias",
      "url": "./feed.php",
      "icons": [{ "src": "./icon.php/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Campos de juego",
      "short_name": "Campos",
      "url": "./fields.php",
      "icons": [{ "src": "./icon.php/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Tienda",
      "short_name": "Tienda",
      "url": "./store.php",
      "icons": [{ "src": "./icon.php/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}