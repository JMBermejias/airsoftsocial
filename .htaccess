# Seguridad básica para hosting Apache
Options -Indexes
DirectoryIndex index.php

# PWA: tipos MIME correctos (manifest + service worker)
#
# OJO: el manifest y los iconos se sirven desde manifest.php e icon.php, que
# ponen sus propias cabeceras, porque AddType no funciona en todos los hostings
# y este fichero lleva nosniff: si el manifest no llega como
# application/manifest+json, Chrome lo descarta entero y no hay icono ni
# instalación. Estas líneas se quedan por si alguien usa el fichero estático.
AddType application/manifest+json .webmanifest
AddType application/javascript .js .mjs

# El service worker necesita poder controlar todo el sitio.
<IfModule mod_headers.c>
  Header set Service-Worker-Allowed "/"
</IfModule>

# SIN mod_rewrite a propósito.
#
# El manifest pide los iconos como icon.php/icon-512.png (rutas fijas, que
# Android cachea mejor que las URLs con ?src=). Eso lo resuelve el propio
# icon.php leyendo REQUEST_URI, sin necesidad de reglas de reescritura.
#
# Antes había un bloque <IfModule mod_rewrite.c> con RewriteEngine On aquí, y
# fue la causa de un 502: en hosting compartido, activar mod_rewrite sin
# permiso o sin las directivas habilitadas en el panel da error de
# configuración, y Apache se queda sin arrancar (500, o 502 si hay PHP-FPM
# detrás). Enterrar el módulo en un IfModule no protege de eso: si el módulo
# está activo, RewriteEngine se ejecuta.
#
# Si algún día hace falta reescritura, debe activarse desde el panel del
# hosting (no aquí) y probarse en un subdominio primero.

# Bloquear el archivo de configuración (contiene contraseñas de la BD)
<FilesMatch "^(config\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Ocultar archivos ocultos (.git, .env, etc.)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# No mostrar errores PHP en producción (configúralo según tu hosting)
# php_flag display_errors off

# Seguridad de cabeceras
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain text/xml image/svg+xml
</IfModule>

# Cache de estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>